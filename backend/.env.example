# SpiceExpress Backend — required environment variables
# Copy to .env and fill in values. NEVER commit the real .env.

# --- SQL Server (required) ---
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DATABASE=CMSDB_21052026
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
MSSQL_TRUST_CERT=true

# --- Auth (required) ---
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- CORS ---
# Deployed frontend origin, e.g. https://spiceexpress-frontend.vercel.app
FRONTEND_URL=http://localhost:5173

# --- Optional ---
PORT=5000
NODE_ENV=development
# MSSQL_INSTANCE=          # named instance (only if no port)
# MSSQL_POOL_MAX=10
# MSSQL_REQUEST_TIMEOUT=30000
# MSSQL_CONNECTION_TIMEOUT=15000

# NOTE: MongoDB is no longer used. MONGO_URI is obsolete — remove it from any .env.
